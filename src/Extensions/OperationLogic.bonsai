            </Expression>
            <Expression xsi:type="MulticastSubject">
              <Name>CuttlefishFipCommands</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>ClearTasks</Name>
            </Expression>
            <Expression xsi:type="rx:CreateObservable">
              <Name>ClearTasks</Name>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="p1:CreateMessage">
                    <harp:MessageType>Write</harp:MessageType>
                    <harp:Payload xsi:type="p1:CreateSetTaskStatePayload">
                      <p1:SetTaskState>Stop</p1:SetTaskState>
                    </harp:Payload>
                  </Expression>
                  <Expression xsi:type="MulticastSubject">
                    <Name>CuttlefishFipCommands</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Delay">
                      <rx:DueTime>PT0.03S</rx:DueTime>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="p1:CreateMessage">
                    <harp:MessageType>Write</harp:MessageType>
                    <harp:Payload xsi:type="p1:CreateClearAllTasksPayload">
                      <p1:ClearAllTasks>Enabled</p1:ClearAllTasks>
                    </harp:Payload>
                  </Expression>
                  <Expression xsi:type="MulticastSubject">
                    <Name>CuttlefishFipCommands</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Take">
                      <rx:Count>1</rx:Count>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="WorkflowOutput" />
                </Nodes>
                <Edges>
