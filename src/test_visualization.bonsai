  <Workflow>
    <Nodes>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Timer">
          <rx:DueTime>PT0S</rx:DueTime>
        </Combinator>
      </Expression>
      <Expression xsi:type="scr:ExpressionTransform">
        <scr:Expression>double(it)</scr:Expression>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:ElementIndex" />
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="RigPath" />
        <Property Name="SessionPath" />
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="Extensions\ReadSchemas.bonsai">
        <RigPath>C:\git\AllenNeuralDynamics\Aind.Physiology.Fip\local\AindPhysioFipRig.json</RigPath>
        <SessionPath>C:\git\AllenNeuralDynamics\Aind.Physiology.Fip\local\Session.json</SessionPath>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>DeserializeSchemas</Name>
        <Workflow>
          <Nodes>
            <Expression xsi:type="SubscribeSubject">
              <Name>RawSessionSchema</Name>
            </Expression>
            <Expression xsi:type="p1:DeserializeFromJson">
              <p1:Type xsi:type="TypeMapping" TypeArguments="p1:Session" />
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
