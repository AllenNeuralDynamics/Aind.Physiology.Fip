                        <Expression xsi:type="MemberSelector">
                          <Selector>Item2.Value</Selector>
                        </Expression>
                        <Expression xsi:type="HasFlag">
                          <Operand xsi:type="WorkflowProperty" TypeArguments="p6:Ports">
                            <Value>IO0</Value>
                          </Operand>
